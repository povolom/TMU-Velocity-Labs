# ROS 2 Humble's environment for VS Code's Testing panel (what `source setup.bash` sets up
# in a terminal), so the lab tests can import rclpy and the lab packages there. The lab
# paths are relative to the repo, where the tests run.
PYTHONPATH=lab2/safety_node:lab3/wall_follow:lab4/gap_follow:sim/lab_sim:/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
LD_LIBRARY_PATH=/opt/ros/humble/opt/rviz_ogre_vendor/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib
AMENT_PREFIX_PATH=${HOME}/velocity_ws/install/gap_follow:${HOME}/velocity_ws/install/wall_follow:${HOME}/velocity_ws/install/lab_sim:/opt/ros/humble
ROS_DISTRO=humble
ROS_VERSION=2
ROS_PYTHON_VERSION=3
# Tests start ROS nodes: keep them off the simulator's ROS domain (0).
ROS_DOMAIN_ID=42
