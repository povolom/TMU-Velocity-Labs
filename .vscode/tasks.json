{
    // Terminal > Run Task... to run a lab (Ctrl+Shift+B builds). Lab tasks build first, then
    // open the simulator and RViz. Stop one with the trash-can icon on its terminal before
    // starting another: only one simulator can run at a time.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build labs",
            "type": "shell",
            "command": "source /opt/ros/humble/setup.bash && cd ~/velocity_ws && colcon build --symlink-install",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && python3 -m pytest -q lab3/wall_follow/test lab4/gap_follow/test",
            "dependsOn": "Build labs",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Lab 1 - Talker and relay",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch lab1_pkg lab1_launch.py",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 2 - 1. Simulator",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch lab_sim sim_launch.py",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 2 - 2. Safety node",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 run safety_node safety_node --ros-args -p use_sim_time:=true",
            "problemMatcher": []
        },
        {
            "label": "Lab 2 - 3. Keyboard driving",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 run teleop_twist_keyboard teleop_twist_keyboard",
            "problemMatcher": []
        },
        {
            "label": "Lab 3 - Wall following (normal, 1.5 m/s)",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch wall_follow wall_follow_launch.py sim:=true",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 3 - Wall following (fast, 10 m/s)",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch wall_follow wall_follow_launch.py sim:=true max_speed:=10.0",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 4 - Follow the gap (normal, 2 m/s)",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch gap_follow levine_blocked_launch.py sim:=true",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 4 - Follow the gap (fast, 10 m/s)",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch gap_follow levine_blocked_launch.py sim:=true max_speed:=10.0",
            "dependsOn": "Build labs",
            "problemMatcher": []
        },
        {
            "label": "Lab 4 - Follow the gap, obstacles (1.5 m/s)",
            "type": "shell",
            "command": "source ~/velocity_ws/install/setup.bash && ros2 launch gap_follow levine_obs_launch.py sim:=true",
            "dependsOn": "Build labs",
            "problemMatcher": []
        }
    ]
}
